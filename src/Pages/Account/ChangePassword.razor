@page "/account/change-password"
@layout AccountLayout
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Change password</PageTitle>

<h1>Change password</h1>

@if (_mustChange)
{
    <p>You are using a temporary password. Choose a new one to continue.</p>
}

@if (_error is not null)
{
    <div class="alert alert-error" role="alert">@_error</div>
}

<EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password">
    <DataAnnotationsValidator />
    <div class="field">
        <label for="current">Current password</label>
        <InputText id="current" type="password" @bind-Value="Input.Current" autocomplete="current-password" />
        <ValidationMessage For="() => Input.Current" />
    </div>
    <div class="field">
        <label for="new">New password</label>
        <InputText id="new" type="password" @bind-Value="Input.New" autocomplete="new-password" />
        <small>At least @PasswordRules.MinLength characters, with a letter and a number.</small>
        <ValidationMessage For="() => Input.New" />
    </div>
    <div class="field">
        <label for="confirm">Confirm new password</label>
        <InputText id="confirm" type="password" @bind-Value="Input.Confirm" autocomplete="new-password" />
        <ValidationMessage For="() => Input.Confirm" />
    </div>
    <button type="submit" class="btn btn-primary">Change password</button>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private ChangeModel Input { get; set; } = new();

    private string? _error;
    private bool _mustChange;

    protected override void OnInitialized() =>
        _mustChange = HttpContext.User.HasClaim(UserInfo.MustChangeClaim, "true");

    private async Task ChangeAsync()
    {
        var me = UserInfo.FromPrincipal(HttpContext.User);
        if (me is null) { Nav.NavigateTo("/account/login"); return; }

        var result = await Auth.ChangePasswordAsync(me.Id, Input.Current, Input.New);
        if (!result.Ok) { _error = result.Error; return; }

        await HttpContext.SignInAsync(result.Value!);   // new cookie: new stamp, no "must change"
        Nav.NavigateTo("/");
    }

    private sealed class ChangeModel
    {
        [Required(ErrorMessage = "Enter your current password.")] public string Current { get; set; } = "";
        [Required(ErrorMessage = "Enter a new password.")] public string New { get; set; } = "";
        [Compare(nameof(New), ErrorMessage = "The two new passwords do not match.")] public string Confirm { get; set; } = "";
    }
}
