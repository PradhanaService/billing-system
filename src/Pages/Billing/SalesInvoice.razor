@page "/invoices/new"
@attribute [Authorize(Policy = nameof(Permission.InvoiceCreate))]
@inherits UserContextBase
@using WaterBilling.Services.Billing
@using WaterBilling.Services.Masters
@inject InvoiceService Svc
@inject VehicleService VehicleSvc
@inject CustomerService CustomerSvc
@inject NavigationManager Nav

<PageTitle>Sales Invoice</PageTitle>

<PageHeader Title="Sales Invoice" IconName="invoice" Subtitle="Record water supply (vehicle) entries and payment.">
    <Actions>
        <div class="number-box"><label>Invoice No.</label><div class="value" title="Expected number. Assigned when you save.">@_nextNo</div></div>
        <div class="number-box"><label>Invoice Date</label><div class="value"><Icon Name="calendar" Size="18" /> @IndianTime.FormatDate(_date)</div></div>
    </Actions>
</PageHeader>

<PageMessage Text="@MessageText" Ok="@MessageOk" />

<section class="section">
    <h2 class="section-title"><Icon Name="edit" Size="22" /> Invoice Details</h2>
    <div class="section-body">
        <div class="inv-row-1">
            <div class="field">
                <label for="supplier">Vehicle Supplier <span class="req">*</span></label>
                <select id="supplier" @bind="_supplierId" @bind:after="OnSupplierChanged">
                    <option value="0">All suppliers</option>
                    @foreach (var s in Suppliers) { <option value="@s.Id" selected="@(s.Id == _supplierId)">@s.Name</option> }
                </select>
            </div>
            <div class="field">
                <label for="mode">Payment Mode <span class="req">*</span></label>
                <select id="mode" @bind="_form.PaymentMode">
                    <option value="@InvoicePaymentMode.Cash">Cash</option>
                    <option value="@InvoicePaymentMode.Credit">Credit</option>
                </select>
            </div>
        </div>
        <div class="inv-row-2">
            <div class="field">
                <label for="vcode">Vehicle No. <span class="req">*</span></label>
                <select id="vcode" @bind="_form.VehicleId" @bind:after="OnVehicleChanged">
                    <option value="0">Choose</option>
                    @foreach (var v in VisibleVehicles) { <option value="@v.Id" selected="@(v.Id == _form.VehicleId)">@v.Code</option> }
                </select>
            </div>
            <div class="field">
                <label for="vname">Vehicle Name <span class="req">*</span></label>
                <select id="vname" @bind="_form.VehicleId" @bind:after="OnVehicleChanged">
                    <option value="0">Choose</option>
                    @foreach (var v in VisibleVehicles.OrderBy(x => x.Nickname)) { <option value="@v.Id" selected="@(v.Id == _form.VehicleId)">@v.Nickname</option> }
                </select>
            </div>
            <div class="field">
                <label for="trips">Trip <span class="req">*</span></label>
                <input id="trips" type="number" min="1" max="99" @bind="_form.Trips" @bind:event="oninput" />
            </div>
            @if (_vehicle?.BillingBasis == BillingBasis.Volume)
            {
                <div class="field">
                    <label for="volume">Volume (kL) <span class="req">*</span></label>
                    <input id="volume" type="number" min="0" step="0.1" @bind="_form.VolumeKl" @bind:event="oninput" />
                </div>
            }
            <div class="field">
                <label for="rate">Rate (₹/@(_vehicle?.BillingBasis == BillingBasis.Volume ? "kL" : "Trip")) <span class="req">*</span></label>
                <input id="rate" type="number" min="0" step="0.01" @bind="_form.Rate" @bind:event="oninput" readonly="@(!Can(Permission.InvoiceOverrideRate))" />
            </div>
            <div class="amount-box">
                <div class="label"><Icon Name="rupee" Size="20" /> Amount (₹)</div>
                <div class="value" aria-live="polite">@PreviewAmount</div>
            </div>
        </div>
        <div class="form-grid">
            <div class="field">
                <label for="billto">Bill To</label>
                <select id="billto" @bind="_form.BillToType">
                    <option value="@PartyType.Supplier">Vehicle supplier</option>
                    <option value="@PartyType.Customer">A customer</option>
                </select>
            </div>
            @if (_form.BillToType == PartyType.Customer)
            {
                <div class="field">
                    <label for="customer">Customer <span class="req">*</span></label>
                    <select id="customer" @bind="_form.CustomerId">
                        <option value="">Choose</option>
                        @foreach (var c in _customers) { <option value="@c.Id">@c.Name</option> }
                    </select>
                </div>
            }
            @if (RateChanged)
            {
                <div class="field">
                    <label for="ratereason">Reason for rate change <span class="req">*</span></label>
                    <input id="ratereason" @bind="_form.RateReason" maxlength="200" />
                </div>
            }
        </div>
    </div>
</section>

<section class="section">
    <h2 class="section-title"><Icon Name="list" Size="22" /> Item Details</h2>
    <table class="data plain">
        <thead><tr><th class="center">S.No</th><th>Material</th><th class="center">Qty</th><th class="center">Measurement</th><th class="num">Rate (₹)</th><th class="num">Total Amount (₹)</th></tr></thead>
        <tbody>
            @if (_vehicle is not null)
            {
                <tr>
                    <td class="center">1</td><td>Water · @_vehicle.Nickname</td>
                    <td class="center">@PreviewQty</td>
                    <td class="center">@(_vehicle.BillingBasis == BillingBasis.Trip ? "TRIP" : "kL")</td>
                    <td class="num">@PreviewRate</td>
                    <td class="num">@PreviewAmount</td>
                </tr>
            }
            else { <tr><td colspan="6" class="muted center">Choose a vehicle.</td></tr> }
        </tbody>
    </table>
</section>

<div class="inv-bottom">
    <div>
        <div class="card button-grid">
            <button class="btn" @onclick="() => GoToAsync(next: false)"><Icon Name="prev" /> Previous</button>
            <button class="btn" disabled title="This is a new invoice: there is no next one yet."><Icon Name="next" /> Next</button>
            <button class="btn" @onclick="ResetForm"><Icon Name="plus" /> New</button>
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(Busy || _vehicle is null)"><Icon Name="save" /> Save</button>
            <a class="btn @(_savedId is null ? "disabled-link" : "")" href="@(_savedId is null ? null : $"/invoices/{_savedId}")"><Icon Name="eye" /> View</a>
            <a class="btn @(_savedId is null ? "disabled-link" : "")" href="@(_savedId is null ? null : $"/pdf/invoice/{_savedId}")" target="_blank" rel="noopener"><Icon Name="printer" /> Print</a>
            <a class="btn" href="/"><Icon Name="exit" /> Exit</a>
        </div>
        <section class="section">
            <h2 class="section-title"><Icon Name="message" Size="22" /> Narration</h2>
            <div class="section-body"><textarea aria-label="Narration" rows="3" maxlength="300" style="width: 100%; box-sizing: border-box" @bind="_form.Narration"></textarea></div>
        </section>
    </div>
    <div class="card total-card">
        <div class="label">Total (₹)</div>
        <div class="total-value">@PreviewAmount</div>
        <p class="muted">Posted invoices are never edited. To correct one, open it with View and cancel it with a reason, then make a new invoice.</p>
    </div>
</div>

@code {
    private InvoiceForm _form = new() { PaymentMode = InvoicePaymentMode.Cash };
    private IReadOnlyList<VehicleForBilling> _vehicles = [];
    private IReadOnlyList<(long Id, string Name)> _customers = [];
    private VehicleForBilling? _vehicle;
    private long _supplierId;
    private string _nextNo = "";
    private DateOnly _date;
    private long? _savedId;

    private IEnumerable<(long Id, string Name)> Suppliers =>
        _vehicles.Select(v => (v.SupplierId, v.SupplierName)).Distinct().OrderBy(s => s.SupplierName);

    private IEnumerable<VehicleForBilling> VisibleVehicles =>
        _supplierId == 0 ? _vehicles : _vehicles.Where(v => v.SupplierId == _supplierId);

    protected override async Task OnUserReadyAsync()
    {
        _vehicles = await VehicleSvc.ListBillableAsync();
        _customers = await CustomerSvc.ListActiveAsync();
        await RefreshHeaderAsync();
    }

    private async Task RefreshHeaderAsync()
    {
        _nextNo = await Svc.PeekNextNumberAsync();
        _date = Svc.BusinessDate();
    }

    private void OnSupplierChanged()
    {
        if (_vehicle is not null && _supplierId != 0 && _vehicle.SupplierId != _supplierId)
        {
            _form.VehicleId = 0;
            OnVehicleChanged();
        }
    }

    // FR-INV-02: choosing code or name fills the other, the supplier and the rate.
    // (Each <option> also marks itself "selected": the supplier filter rebuilds the lists, and
    //  without it the browser would show "Choose" even though a vehicle is picked.)
    private void OnVehicleChanged()
    {
        _vehicle = _vehicles.FirstOrDefault(v => v.Id == _form.VehicleId);
        if (_vehicle is not null) _supplierId = _vehicle.SupplierId;
        _form.Rate = _vehicle is null ? 0 : Money.ToRupees(_vehicle.RatePaise);
        _form.RateReason = null;
    }

    private bool RateChanged => _vehicle is not null && _form.Rate != Money.ToRupees(_vehicle.RatePaise);

    private long? PreviewPaise
    {
        get
        {
            if (_vehicle is null || _form.Trips < 1 || _form.Rate <= 0) return null;
            try
            {
                return InvoiceMath.Amount(_vehicle.BillingBasis, _form.Trips,
                    Volume.FromKilolitres(Math.Round(_form.VolumeKl, 1)), Money.RoundHalfUp(_form.Rate));
            }
            catch (Exception) { return null; }   // half-typed input: no preview yet
        }
    }

    private string PreviewAmount => PreviewPaise is { } p ? Money.Format(p) : "0.00";
    private string PreviewRate => _form.Rate > 0 ? Money.Format(Money.RoundHalfUp(_form.Rate)) : "-";
    private string PreviewQty => _vehicle?.BillingBasis == BillingBasis.Volume ? _form.VolumeKl.ToString("0.0") : _form.Trips.ToString();

    private async Task SaveAsync()
    {
        if (Busy) return;   // a click that arrives while saving does nothing (NFR-CON-06)
        Busy = true;
        try
        {
            var result = await Svc.CreateAsync(_form);
            if (result.Ok)
            {
                var saved = await Svc.GetAsync(result.Value);
                _savedId = result.Value;
                ShowOk($"Invoice {saved?.DisplayNo} saved for ₹{Money.Format(saved?.AmountPaise ?? 0)}. Use Print for the PDF.");
                var mode = _form.PaymentMode;
                ResetForm();
                _form.PaymentMode = mode;
                await RefreshHeaderAsync();
            }
            else ShowError(result.Error!);
        }
        finally { Busy = false; }
    }

    // Previous = the latest saved invoice (FR-INV-14).
    private async Task GoToAsync(bool next)
    {
        var target = await Svc.NeighbourAsync(long.MaxValue, next);
        if (target is null) ShowError("There are no invoices yet.");
        else Nav.NavigateTo($"/invoices/{target}");
    }

    private void ResetForm()
    {
        _form = new InvoiceForm { PaymentMode = _form.PaymentMode };
        _vehicle = null;
        _supplierId = 0;
    }
}
