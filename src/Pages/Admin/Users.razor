@page "/admin/users"
@attribute [Authorize(Policy = nameof(Permission.UsersManage))]
@inject UserService UserSvc

@* Password Management (Admin only, final design Nov 2026). There are only two logins: Admin and the
   shared Sales login. The Admin sets either password here; it works from the next sign-in (that
   login's open sessions are signed out). The sales persons' names for "Created by" and "Deleted by"
   are kept on the Sales Persons page. *@

<PageTitle>Password Management</PageTitle>

<PageHeader IconName="key" Title="Password Management" Subtitle="Change the passwords of the two logins: Admin and Sales Person." />

@if (_message is not null)
{
    <div class="alert @(_messageOk ? "alert-ok" : "alert-error")" role="status">@_message</div>
}

<div class="login-cards">
    @foreach (var c in _cards)
    {
        var role = c.Role;
        var title = RolePermissions.DisplayName(role);
        <div class="card login-card" id="card-@role">
            <div class="login-head">
                <span class="login-tile @(role == UserRole.Admin ? "dark" : "")"><Icon Name="@(role == UserRole.Admin ? "shield" : "badge")" Size="24" /></span>
                <div><div class="login-role">@title</div><div class="muted small">User name <b>@(c.UserName ?? UserService.SalesUserName)</b></div></div>
                <span class="badge @(c.Id is null ? "badge-off" : "")">@(c.Id is null ? "Not created yet" : "Active")</span>
            </div>
            <div class="login-facts">
                <span class="muted">Password last changed</span><span>@When(c.PasswordChangedAtUtc)</span>
                <span class="muted">Last sign-in</span><span>@When(c.LastLoginAtUtc)</span>
            </div>
            <div class="field">
                <label for="new-@role">New password*</label>
                <span class="pw-box">
                    <input id="new-@role" type="@(_show.Contains(role) ? "text" : "password")" placeholder="At least @PasswordRules.MinLength characters" autocomplete="new-password"
                           value="@Get(_new, role)" @oninput="e => _new[role] = e.Value?.ToString()" />
                    <button type="button" class="icon-btn" aria-label="Show password" @onclick="() => ToggleShow(role)"><Icon Name="eye" Size="16" /></button>
                </span>
            </div>
            <div class="field">
                <label for="confirm-@role">Confirm new password*</label>
                <span class="pw-box">
                    <input id="confirm-@role" type="@(_show.Contains(role) ? "text" : "password")" placeholder="Type it again" autocomplete="new-password"
                           value="@Get(_confirm, role)" @oninput="e => _confirm[role] = e.Value?.ToString()" />
                    <button type="button" class="icon-btn" aria-label="Show password" @onclick="() => ToggleShow(role)"><Icon Name="eye" Size="16" /></button>
                </span>
            </div>
            <p class="muted small">Any letters, numbers or symbols, at least @PasswordRules.MinLength characters.</p>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="() => SaveAsync(role)" disabled="@_busy">@(c.Id is null ? $"Create {title} login" : $"Change {title} password")</button>
            </div>
        </div>
    }
</div>

<p class="muted small">There are only these two users. The shared Sales login is used by all sales persons; their names for "Created by" and "Deleted by" are kept on the Sales Persons page.</p>

@code {
    private IReadOnlyList<LoginCard> _cards = [];
    private readonly Dictionary<UserRole, string?> _new = [], _confirm = [];
    private readonly HashSet<UserRole> _show = [];
    private string? _message;
    private bool _messageOk, _busy;

    protected override async Task OnInitializedAsync() => _cards = await UserSvc.LoginsAsync();

    private static string Get(Dictionary<UserRole, string?> d, UserRole r) => d.GetValueOrDefault(r) ?? "";
    private static string When(DateTime? utc) => utc is { } t ? IndianTime.FormatDateTime(DateTime.SpecifyKind(t, DateTimeKind.Utc)) : "Not yet";
    private void ToggleShow(UserRole r) { if (!_show.Remove(r)) _show.Add(r); }

    private async Task SaveAsync(UserRole role)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var result = await UserSvc.SetPasswordAsync(role, _new.GetValueOrDefault(role), _confirm.GetValueOrDefault(role));
            _messageOk = result.Ok;
            _message = result.Ok ? $"{RolePermissions.DisplayName(role)} password changed. The new password works from the next sign-in." : result.Error;
            if (result.Ok) { _new.Remove(role); _confirm.Remove(role); _cards = await UserSvc.LoginsAsync(); }
        }
        finally { _busy = false; }
    }
}
