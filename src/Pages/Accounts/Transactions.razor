@page "/transactions"
@page "/receipts"
@page "/payments"
@attribute [Authorize(Policy = nameof(Permission.ReceiptCreate))]
@inherits UserContextBase
@using WaterBilling.Components.Transactions
@inject NavigationManager Nav

<PageTitle>Transactions</PageTitle>

<PageHeader Title="Transactions" IconName="swap" Subtitle="Manage receipts and payments with complete details." />

<div class="tabs" role="tablist">
    <button role="tab" class="tab @(_tab == "receipt" ? "active" : "")" aria-selected="@(_tab == "receipt")" @onclick="@(() => _tab = "receipt")">
        <Icon Name="download" Size="24" /> Receipt <small>(Receive Money)</small>
    </button>
    @if (Can(Permission.PaymentCreate))
    {
        <button role="tab" class="tab @(_tab == "payment" ? "active" : "")" aria-selected="@(_tab == "payment")" @onclick="@(() => _tab = "payment")">
            <Icon Name="upload" Size="24" /> Payment <small>(Make Payment)</small>
        </button>
    }
</div>

@if (_tab == "payment" && Can(Permission.PaymentCreate)) { <PaymentVoucher /> }
else { <ReceiptVoucher /> }

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private string _tab = "receipt";

    protected override Task OnUserReadyAsync()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        _tab = Tab == "payment" || path.StartsWith("/payments") ? "payment" : "receipt";
        return Task.CompletedTask;
    }
}
