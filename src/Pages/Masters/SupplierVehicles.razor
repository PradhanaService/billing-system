@page "/suppliers/{SupplierId:long}/vehicles"
@attribute [Authorize(Policy = nameof(Permission.MastersView))]
@inherits UserContextBase
@using WaterBilling.Services.Masters
@inject SupplierService Suppliers
@inject VehicleService Vehicles

@* Vehicles of one supplier, opened by tapping the supplier's name in Supplier Master.
   Read-only: it shows the vehicles exactly as Vehicle Master has them (to change one, use Vehicle Master).
   Deleted vehicles are not listed; Inactive and Maintenance ones are, with their status. *@

<PageTitle>Vehicles of @(_supplier?.Name ?? "supplier")</PageTitle>

<PageHeader IconName="truck" Title="@($"Vehicles of {_supplier?.Name ?? "supplier"}")" Subtitle="Every vehicle under this supplier, from Vehicle Master.">
    <a class="btn" href="/suppliers"><Icon Name="chevron-left" Size="18" /> Back to Supplier Master</a>
</PageHeader>

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_supplier is null)
{
    <div class="alert alert-error" role="alert">This supplier was not found. It may have been deleted.</div>
}
else
{
    <div class="card supplier-facts">
        <span><small class="muted">Supplier</small><b>@_supplier.Name</b></span>
        <span><small class="muted">Contact</small><b>@(_supplier.ContactPerson ?? "-")</b></span>
        <span><small class="muted">Phone</small><b>@_supplier.Phone</b></span>
        <span><small class="muted">Address</small><b>@(_supplier.Address ?? "-")</b></span>
        <span><small class="muted">Vehicles</small><b>@_rows.Count</b></span>
    </div>

    <div class="card">
        <table class="data">
            <thead><tr><th>Code</th><th>Vehicle No.</th><th>Vehicle Name</th><th class="num">Capacity (L)</th><th class="num">Rate (₹)</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var v in _rows)
                {
                    <tr class="@(v.Status == VehicleStatus.Active ? "" : "muted")">
                        <td>@v.Code</td><td class="nowrap">@v.VehicleNo</td><td>@v.Nickname</td>
                        <td class="num">@v.TankCapacityLitres.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                        <td class="num">@Money.Format(v.RatePaise) / trip</td>
                        <td><span class="badge @(v.Status == VehicleStatus.Active ? "" : "badge-off")">@v.Status</span></td>
                    </tr>
                }
                @if (_rows.Count == 0) { <tr><td colspan="6" class="muted">This supplier has no vehicles yet. Add them in Vehicle Master.</td></tr> }
            </tbody>
        </table>
        <p class="muted" style="margin: 0.75rem 0 0; font-size: 0.85rem">@_rows.Count vehicle(s) · to change a vehicle, use Vehicle Master.</p>
    </div>
}

@code {
    [Parameter] public long SupplierId { get; set; }

    private SupplierForm? _supplier;
    private IReadOnlyList<VehicleRow> _rows = [];
    private bool _loading = true;

    protected override async Task OnUserReadyAsync()
    {
        _supplier = await Suppliers.GetAsync(SupplierId);
        if (_supplier is not null) _rows = await Vehicles.SearchAsync(null, StatusFilter.All, SupplierId);
        _loading = false;
    }
}
