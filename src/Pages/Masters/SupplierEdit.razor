@page "/suppliers/new"
@page "/suppliers/{Id:long}/edit"
@attribute [Authorize(Policy = nameof(Permission.MastersEdit))]
@inherits UserContextBase
@using WaterBilling.Services.Masters
@inject SupplierService Svc
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add Supplier" : "Edit Supplier")</PageTitle>

<PageHeader Title="@(IsNew ? "Add Supplier" : "Edit Supplier")" IconName="truck"
            Subtitle="@(IsNew ? "Create a new vehicle supplier with contact details." : "Update this supplier's details.")">
    <Actions>
        <a class="btn btn-lg" href="@BackHref"><Icon Name="prev" /> Back to @(BackToVehicles ? "Vehicle Master" : "Suppliers")</a>
    </Actions>
</PageHeader>

<PageMessage Text="@MessageText" Ok="@MessageOk" />

@if (_form is not null)
{
    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <section class="section">
            <h2 class="section-title"><Icon Name="users" Size="24" /> Supplier Details</h2>
            <div class="section-body">
                <div class="form-2col">
                    <div class="field">
                        <label for="name">Supplier Name <span class="req">*</span></label>
                        <InputText id="name" @bind-Value="_form.Name" />
                        <ValidationMessage For="() => _form.Name" />
                    </div>
                    <div class="field">
                        <label for="contact">Contact Person</label>
                        <InputText id="contact" @bind-Value="_form.ContactPerson" />
                    </div>
                    <div class="field">
                        <label for="phone">Phone No. <span class="req">*</span></label>
                        <InputText id="phone" @bind-Value="_form.Phone" inputmode="tel" />
                        <ValidationMessage For="() => _form.Phone" />
                    </div>
                    <div class="field">
                        <label for="alt">Alternate Phone No.</label>
                        <InputText id="alt" @bind-Value="_form.AltPhone" inputmode="tel" />
                        <ValidationMessage For="() => _form.AltPhone" />
                    </div>
                    <div class="field">
                        <label for="short">Short name <span class="req">*</span></label>
                        <InputText id="short" @bind-Value="_form.ShortName" />
                        <small>Used to build vehicle names, e.g. "Sangeetha TN 38 M 3".</small>
                        <ValidationMessage For="() => _form.ShortName" />
                    </div>
                    <div class="field">
                        <label for="ob">Opening balance (₹)</label>
                        <div style="display: flex; gap: 0.5rem">
                            <InputNumber id="ob" @bind-Value="_form.OpeningBalance" step="0.01" min="0" readonly="@(!IsNew)" style="flex: 1" />
                            <InputSelect @bind-Value="_form.OpeningBalanceSide" disabled="@(!IsNew)" aria-label="Dr or Cr">
                                <option value="@BalanceSide.Dr">Dr (owes us)</option>
                                <option value="@BalanceSide.Cr">Cr (we owe)</option>
                            </InputSelect>
                        </div>
                        <small>@(IsNew ? "Posted to the ledger once, when saved." : "Fixed after creation.")</small>
                        <ValidationMessage For="() => _form.OpeningBalance" />
                    </div>
                </div>
                <div class="field">
                    <label for="addr">Address</label>
                    <InputTextArea id="addr" @bind-Value="_form.Address" rows="3" />
                </div>
                <label class="switch">
                    <span style="color: var(--navy)">Status</span>
                    <input type="checkbox" checked="@(_form.Status == RecordStatus.Active)"
                           @onchange="e => _form.Status = (bool)e.Value! ? RecordStatus.Active : RecordStatus.Inactive" />
                    @(_form.Status == RecordStatus.Active ? "Active" : "Inactive")
                </label>
            </div>
        </section>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-lg" disabled="@Busy"><Icon Name="save" /> Save</button>
            <a class="btn btn-lg" href="@BackHref"><Icon Name="x" /> Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public long? Id { get; set; }
    [SupplyParameterFromQuery(Name = "back")] public string? Back { get; set; }

    private bool IsNew => Id is null;
    private bool BackToVehicles => Back == "vehicles";
    private string BackHref => BackToVehicles ? "/vehicles" : "/suppliers";
    private SupplierForm? _form;

    protected override async Task OnUserReadyAsync()
    {
        _form = IsNew ? new SupplierForm() : await Svc.GetAsync(Id!.Value);
        if (_form is null) ShowError("Supplier not found.");
    }

    private async Task SaveAsync()
    {
        if (_form is null) return;
        if (Busy) return;   // a click that arrives while saving does nothing (NFR-CON-06)
        Busy = true;
        try
        {
            var result = IsNew ? (await Svc.CreateAsync(_form)) is var r && r.Ok ? Result.Success() : Result.Fail(r.Error!)
                               : await Svc.UpdateAsync(Id!.Value, _form);
            if (result.Ok) Nav.NavigateTo($"{BackHref}?saved={Uri.EscapeDataString("Supplier " + PartyRules.Tidy(_form.Name))}");
            else ShowError(result.Error!);
        }
        finally { Busy = false; }
    }
}
