@page "/vehicles"
@attribute [Authorize(Policy = nameof(Permission.MastersView))]
@inherits UserContextBase
@using WaterBilling.Services.Masters
@inject VehicleService Svc

<PageTitle>Vehicle Master</PageTitle>

<PageHeader Title="Vehicle Master" IconName="truck" Subtitle="Tankers with their supplier, tank capacity and billing rate.">
    <Actions>
        @if (Can(Permission.MastersEdit))
        {
            <a class="btn btn-primary btn-lg" href="/suppliers/new?back=vehicles"><Icon Name="users" /> Add Supplier</a>
            <a class="btn btn-primary btn-lg" href="/vehicles/new"><Icon Name="plus" /> Add Vehicle</a>
        }
    </Actions>
</PageHeader>

<PageMessage Text="@MessageText" Ok="@MessageOk" />

<div class="toolbar">
    <label class="input-icon search-box">
        <Icon Name="search" Size="20" />
        <input aria-label="Search" @bind="_search" @bind:event="oninput" @bind:after="LoadAsync" placeholder="Search by Vehicle No., code, name or supplier..." />
    </label>
    <span class="grow"></span>
    <select aria-label="Status" @bind="_filter" @bind:after="LoadAsync" style="min-width: 220px">
        <option value="@StatusFilter.Active">Active</option>
        <option value="@StatusFilter.Inactive">Inactive / Maintenance</option>
        <option value="@StatusFilter.All">All</option>
    </select>
</div>

<div class="table-wrap">
    <table class="data">
        <thead>
            <tr><th class="center">S.No.</th><th>Code</th><th>Vehicle No.</th><th>Supplier</th><th class="num">Capacity (Ltrs)</th>
                <th class="num">Trip Cost (₹)</th><th class="num">Rate (₹)</th><th class="center">Status</th><th class="center">Action</th></tr>
        </thead>
        <tbody>
            @for (var i = 0; i < _rows.Count; i++)
            {
                var v = _rows[i];
                <tr class="@(v.Status != VehicleStatus.Active || !v.SupplierActive ? "muted" : "")">
                    <td class="center">@(i + 1)</td>
                    <td>@v.Code</td>
                    <td class="nowrap"><strong>@v.VehicleNo</strong></td>
                    <td>@v.SupplierName @if (!v.SupplierActive) { <span class="badge badge-off">supplier inactive</span> }</td>
                    <td class="num">@v.TankCapacityLitres.ToString("N0", India)</td>
                    <td class="num">@Money.Format(v.TripCostPaise)</td>
                    <td class="num">@Money.Format(v.RatePaise) / @(v.BillingBasis == BillingBasis.Trip ? "trip" : "kL")</td>
                    <td class="center"><span class="badge @(v.Status != VehicleStatus.Active ? "badge-off" : "")">@v.Status</span></td>
                    <td class="center nowrap">
                        @if (Can(Permission.MastersEdit))
                        {
                            <a class="icon-btn" href="/vehicles/@v.Id/edit" title="Edit @v.VehicleNo" aria-label="Edit @v.VehicleNo"><Icon Name="edit" Size="22" /></a>
                            @if (_confirmDeleteId == v.Id)
                            {
                                <button class="btn btn-small btn-danger" @onclick="() => DeleteAsync(v.Id)">Confirm delete</button>
                            }
                            else
                            {
                                <button class="icon-btn danger" @onclick="() => _confirmDeleteId = v.Id" title="Delete @v.VehicleNo" aria-label="Delete @v.VehicleNo"><Icon Name="trash" Size="22" /></button>
                            }
                        }
                    </td>
                </tr>
            }
            @if (_rows.Count == 0) { <tr><td colspan="9" class="muted center">No vehicles found.</td></tr> }
        </tbody>
    </table>
</div>

@code {
    private static readonly System.Globalization.CultureInfo India = System.Globalization.CultureInfo.GetCultureInfo("en-IN");

    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }

    private IReadOnlyList<VehicleRow> _rows = [];
    private long? _confirmDeleteId;
    private string _search = "";
    private StatusFilter _filter = StatusFilter.Active;

    protected override Task OnUserReadyAsync()
    {
        if (!string.IsNullOrEmpty(Saved)) ShowOk($"{Saved} saved.");
        return LoadAsync();
    }

    private async Task LoadAsync() => _rows = await Svc.SearchAsync(_search, _filter);

    private async Task DeleteAsync(long id)
    {
        _confirmDeleteId = null;
        Show(await Svc.DeleteAsync(id), "Vehicle deleted.");
        await LoadAsync();
    }
}
