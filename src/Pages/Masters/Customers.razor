@page "/customers"
@attribute [Authorize(Policy = nameof(Permission.MastersView))]
@inherits UserContextBase
@using WaterBilling.Services.Masters
@inject CustomerService Svc

<PageTitle>Customer Master</PageTitle>

<h1>Customer Master</h1>

<PageMessage Text="@MessageText" Ok="@MessageOk" />

@if (_form is not null)
{
    <div class="card">
        <h2>@(_editingId is null ? "Add customer" : $"Edit customer: {_form.Name}")</h2>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <div class="field">
                    <label for="name">Customer Name*</label>
                    <InputText id="name" @bind-Value="_form.Name" />
                    <ValidationMessage For="() => _form.Name" />
                </div>
                <div class="field">
                    <label for="phone">Phone No.*</label>
                    <InputText id="phone" @bind-Value="_form.Phone" inputmode="tel" />
                    <ValidationMessage For="() => _form.Phone" />
                </div>
                <div class="field">
                    <label for="status">Status</label>
                    <InputSelect id="status" @bind-Value="_form.Status">
                        <option value="@RecordStatus.Active">Active</option>
                        <option value="@RecordStatus.Inactive">Inactive</option>
                    </InputSelect>
                </div>
                <div class="field">
                    <label for="ob">Opening balance (₹)</label>
                    <InputNumber id="ob" @bind-Value="_form.OpeningBalance" step="0.01" min="0" readonly="@(_editingId is not null)" />
                    <ValidationMessage For="() => _form.OpeningBalance" />
                    @if (_editingId is not null) { <small>Fixed after creation. It is posted to the ledger once.</small> }
                </div>
                <div class="field">
                    <label for="obside">Dr / Cr</label>
                    <InputSelect id="obside" @bind-Value="_form.OpeningBalanceSide" disabled="@(_editingId is not null)">
                        <option value="@BalanceSide.Dr">Dr (customer owes us)</option>
                        <option value="@BalanceSide.Cr">Cr (we owe customer)</option>
                    </InputSelect>
                </div>
            </div>
            <div class="field">
                <label for="addr">Address</label>
                <InputTextArea id="addr" @bind-Value="_form.Address" rows="2" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@Busy">Save</button>
                <button type="button" class="btn" @onclick="() => _form = null">Cancel</button>
            </div>
        </EditForm>
    </div>
}

<div class="toolbar">
    <div class="field">
        <label for="search">Search</label>
        <input id="search" @bind="_search" @bind:event="oninput" @bind:after="LoadAsync" placeholder="Name or phone" />
    </div>
    <div class="field">
        <label for="filter">Show</label>
        <select id="filter" @bind="_filter" @bind:after="LoadAsync">
            <option value="@StatusFilter.Active">Active</option>
            <option value="@StatusFilter.Inactive">Inactive</option>
            <option value="@StatusFilter.All">All</option>
        </select>
    </div>
    @if (Can(Permission.MastersEdit))
    {
        <button class="btn btn-primary" @onclick="StartNew">Add customer</button>
    }
</div>

<table class="data">
    <thead><tr><th>Customer</th><th>Phone</th><th>Address</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var s in _rows)
        {
            <tr class="@(s.Status == RecordStatus.Inactive ? "muted" : "")">
                <td>@s.Name</td>
                <td>@s.Phone</td>
                <td>@s.Address</td>
                <td><span class="badge @(s.Status == RecordStatus.Inactive ? "badge-off" : "")">@s.Status</span></td>
                <td>
                    @if (Can(Permission.MastersEdit))
                    {
                        <button class="btn btn-small" @onclick="() => EditAsync(s.Id)">Edit</button>
                        @if (_confirmDeleteId == s.Id)
                        {
                            <button class="btn btn-small btn-danger" @onclick="() => DeleteAsync(s.Id)">Confirm delete</button>
                        }
                        else
                        {
                            <button class="btn btn-small btn-danger" @onclick="() => _confirmDeleteId = s.Id">Delete</button>
                        }
                    }
                </td>
            </tr>
        }
        @if (_rows.Count == 0)
        {
            <tr><td colspan="5" class="muted">No customers found.</td></tr>
        }
    </tbody>
</table>

@code {
    private IReadOnlyList<CustomerRow> _rows = [];
    private CustomerForm? _form;
    private long? _editingId;
    private long? _confirmDeleteId;
    private string _search = "";
    private StatusFilter _filter = StatusFilter.Active;

    protected override Task OnUserReadyAsync() => LoadAsync();

    private async Task LoadAsync() => _rows = await Svc.SearchAsync(_search, _filter);

    private void StartNew() { _form = new CustomerForm(); _editingId = null; MessageText = null; }

    private async Task EditAsync(long id)
    {
        _form = await Svc.GetAsync(id);
        _editingId = _form is null ? null : id;
        MessageText = null;
    }

    private async Task SaveAsync()
    {
        if (_form is null) return;
        if (Busy) return;   // a click that arrives while saving does nothing (NFR-CON-06)
        Busy = true;
        try
        {
            if (_editingId is { } id)
            {
                var result = await Svc.UpdateAsync(id, _form);
                Show(result, "Customer saved.");
                if (result.Ok) _form = null;
            }
            else
            {
                var result = await Svc.CreateAsync(_form);
                if (result.Ok) { ShowOk("Customer added."); _form = null; }
                else ShowError(result.Error!);
            }
            await LoadAsync();
        }
        finally { Busy = false; }
    }

    private async Task DeleteAsync(long id)
    {
        _confirmDeleteId = null;
        Show(await Svc.DeleteAsync(id), "Customer deleted.");
        await LoadAsync();
    }
}
