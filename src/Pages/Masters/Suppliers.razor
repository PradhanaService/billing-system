@page "/suppliers"
@attribute [Authorize(Policy = nameof(Permission.MastersView))]
@inherits UserContextBase
@using WaterBilling.Services.Masters
@inject SupplierService Svc

<PageTitle>Suppliers</PageTitle>

<PageHeader Title="Suppliers" IconName="users" Subtitle="Vehicle suppliers and their contact details.">
    <Actions>
        @if (Can(Permission.MastersEdit)) { <a class="btn btn-primary btn-lg" href="/suppliers/new"><Icon Name="plus" /> Add Supplier</a> }
    </Actions>
</PageHeader>

<PageMessage Text="@MessageText" Ok="@MessageOk" />

<div class="toolbar">
    <label class="input-icon search-box">
        <Icon Name="search" Size="20" />
        <input aria-label="Search" @bind="_search" @bind:event="oninput" @bind:after="LoadAsync" placeholder="Search by name, phone or contact..." />
    </label>
    <span class="grow"></span>
    <select aria-label="Status" @bind="_filter" @bind:after="LoadAsync" style="min-width: 200px">
        <option value="@StatusFilter.Active">Active</option>
        <option value="@StatusFilter.Inactive">Inactive</option>
        <option value="@StatusFilter.All">All</option>
    </select>
</div>

<div class="table-wrap">
    <table class="data">
        <thead><tr><th class="center">S.No.</th><th>Supplier Name</th><th>Short name</th><th>Contact Person</th><th>Phone No.</th><th class="num">Vehicles</th><th class="center">Status</th><th class="center">Action</th></tr></thead>
        <tbody>
            @for (var i = 0; i < _rows.Count; i++)
            {
                var s = _rows[i];
                <tr class="@(s.Status == RecordStatus.Inactive ? "muted" : "")">
                    <td class="center">@(i + 1)</td>
                    <td><strong>@s.Name</strong></td>
                    <td>@s.ShortName</td>
                    <td>@s.ContactPerson</td>
                    <td class="nowrap">@s.Phone</td>
                    <td class="num">@s.VehicleCount</td>
                    <td class="center"><span class="badge @(s.Status == RecordStatus.Inactive ? "badge-off" : "")">@s.Status</span></td>
                    <td class="center nowrap">
                        @if (Can(Permission.MastersEdit))
                        {
                            <a class="icon-btn" href="/suppliers/@s.Id/edit" title="Edit @s.Name" aria-label="Edit @s.Name"><Icon Name="edit" Size="22" /></a>
                            @if (_confirmDeleteId == s.Id)
                            {
                                <button class="btn btn-small btn-danger" @onclick="() => DeleteAsync(s.Id)">Confirm delete</button>
                            }
                            else
                            {
                                <button class="icon-btn danger" @onclick="() => _confirmDeleteId = s.Id" title="Delete @s.Name" aria-label="Delete @s.Name"><Icon Name="trash" Size="22" /></button>
                            }
                        }
                    </td>
                </tr>
            }
            @if (_rows.Count == 0) { <tr><td colspan="8" class="muted center">No suppliers found.</td></tr> }
        </tbody>
    </table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }

    private IReadOnlyList<SupplierRow> _rows = [];
    private long? _confirmDeleteId;
    private string _search = "";
    private StatusFilter _filter = StatusFilter.Active;

    protected override Task OnUserReadyAsync()
    {
        if (!string.IsNullOrEmpty(Saved)) ShowOk($"{Saved} saved.");
        return LoadAsync();
    }

    private async Task LoadAsync() => _rows = await Svc.SearchAsync(_search, _filter);

    private async Task DeleteAsync(long id)
    {
        _confirmDeleteId = null;
        Show(await Svc.DeleteAsync(id), "Supplier deleted.");
        await LoadAsync();
    }
}
