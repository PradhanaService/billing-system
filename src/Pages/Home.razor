@page "/"
@attribute [Authorize(Policy = nameof(Permission.DashboardView))]
@inherits UserContextBase
@using WaterBilling.Services.Accounts
@inject DashboardService Svc

@* Dashboard: this month's and today's sales, receipts, payments, outstanding and cash, a 6-month
   sales chart, quick links and the last 3 invoices. The figures refresh by themselves after any save.
   Clicking "Outstanding amount" opens the list of who has to pay. *@

<PageTitle>Dashboard · Water Supply Billing</PageTitle>

<PageHeader IconName="home" Title="Dashboard" Subtitle="Sales, money in and out, and cash for the month and for today.">
    <div class="field">
        <label for="month">Month</label>
        <input id="month" type="month" @bind="_month" @bind:after="LoadAsync" />
    </div>
</PageHeader>

@if (_d is not null)
{
    <div class="cards cards-4">
        @Stat("chart", $"Total sales ({MonthName})", $"₹{Money.Format(_d.MonthSalesPaise)}", dark: true)
        @Stat("rupee", "Today's sales", $"₹{Money.Format(_d.TodaySalesPaise)}")
        @Stat("download", "Today's receipt", $"₹{Money.Format(_d.TodayReceiptsPaise)}")
        @Stat("upload", "Today's payment", $"₹{Money.Format(_d.TodayPaymentsPaise)}")
    </div>
    <div class="cards cards-3">
        @Stat("cash", $"Cash sales ({MonthName})", $"₹{Money.Format(_d.MonthCashSalesPaise)}")
        @Stat("card", $"Credit sales ({MonthName})", $"₹{Money.Format(_d.MonthCreditSalesPaise)}")
        @Stat("truck", $"Water trips ({MonthName})", _d.MonthTrips.ToString())
        @* Opens the detail: who has to give money. *@
        <a class="stat has-icon stat-link stat-edge" href="/outstanding" title="See who has to pay">
            <span class="stat-icon"><Icon Name="wallet" Size="22" /></span>
            <span class="stat-body">
                <div class="stat-label">Outstanding amount</div><div class="stat-value">₹@Money.Format(_d.OutstandingPaise)</div>
                <div class="stat-more">View details</div>
            </span>
        </a>
        @Stat("clock", "Opening cash (today)", $"₹{Money.Format(_d.OpeningCashPaise)}")
        @Stat("wallet", "Closing cash (today)", $"₹{Money.Format(_d.ClosingCashPaise)}")
    </div>

    <div class="dash-grid">
        <div class="card">
            <SalesBarChart Months="_d.LastSixMonths" SelectedKey="@($"{_d.Year:0000}-{_d.Month:00}")" />
        </div>
        <div>
            <div class="card">
                <h2>Quick access</h2>
                <div class="quick">
                    @if (Can(Permission.InvoiceCreate)) { <a class="quick-tile" href="/invoices/new"><Icon Name="file-text" Size="26" />Sales Invoice</a> }
                    @if (Can(Permission.DaySalesView)) { <a class="quick-tile" href="/invoices"><Icon Name="table" Size="26" />Invoice Display</a> }
                    <a class="quick-tile" href="/vehicles"><Icon Name="truck" Size="26" />Vehicle Master</a>
                    @if (Can(Permission.ReportsView)) { <a class="quick-tile" href="/reports"><Icon Name="chart" Size="26" />Reports</a> }
                </div>
            </div>
            <div class="card">
                <h2>Recent invoices</h2>
                <table class="data">
                    <tbody>
                        @foreach (var i in _d.RecentInvoices)
                        {
                            <tr class="@(i.Status == InvoiceStatus.Cancelled ? "muted" : "")">
                                <td class="nowrap"><a href="/invoices/@i.Id">@i.DisplayNo</a></td><td class="nowrap">@i.VehicleNo</td><td>@i.BillToName</td>
                                <td class="num">@Money.Format(i.AmountPaise)</td>
                            </tr>
                        }
                        @if (_d.RecentInvoices.Count == 0) { <tr><td class="muted">No invoices yet.</td></tr> }
                    </tbody>
                </table>
                @if (Can(Permission.DaySalesView)) { <p><a href="/invoices">View all</a></p> }
            </div>
        </div>
    </div>
}

@code {
    private DashboardData? _d;
    private DateTime _month;

    private string MonthName => _d is null ? "" : new DateTime(_d.Year, _d.Month, 1).ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnUserReadyAsync()
    {
        _d = await Svc.GetAsync();
        _month = new DateTime(_d.Year, _d.Month, 1);
        RefreshWhenDataChanges(LoadAsync);   // figures update as soon as anyone saves
    }

    // One figure card: an icon tile, a label and the value. "dark" gives the icon tile Royal Blue.
    private static RenderFragment Stat(string icon, string label, string value, bool dark = false) => __builder =>
    {
        <div class="stat has-icon @(dark ? "stat-dark" : "")">
            <span class="stat-icon"><Icon Name="@icon" Size="22" /></span>
            <span class="stat-body"><div class="stat-label">@label</div><div class="stat-value">@value</div></span>
        </div>
    };

    private async Task LoadAsync()
    {
        if (_month.Year > 2000) _d = await Svc.GetAsync(_month.Year, _month.Month);
    }
}
