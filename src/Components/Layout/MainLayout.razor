@* The frame around every page: top bar, side menu, and the page itself in @Body. *@
@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <span class="brand">Shree Karunambika Traders</span>
        <span class="subtitle">Water Supply &amp; Fleet Billing</span>
    </header>

    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">×</a>
</div>
