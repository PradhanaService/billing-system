@* The frame around every page: top bar, side menu, and the page itself in @Body. *@
@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <span class="brand-text">
            <span class="brand">Shree Karunambika Traders</span>
            <span class="subtitle">Water Supply &amp; Fleet Billing</span>
        </span>
        <AuthorizeView>
            <Authorized>
                @* The signed-in user, then Change password and Sign out, as in the final design. *@
                <div class="user-menu">
                    <span class="avatar" aria-hidden="true">@Initial(context.User)</span>
                    <span class="user-name">
                        <b>@context.User.Identity?.Name</b>
                        <small>@RoleName(context.User)</small>
                    </span>
                    <a class="top-link" href="/account/change-password">Change password</a>
                    <form action="/account/logout" method="post" class="top-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="top-link">Sign out</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss" href="">Dismiss</a>
</div>

@code {
    private static string RoleName(System.Security.Claims.ClaimsPrincipal p) =>
        UserInfo.FromPrincipal(p) is { } u ? RolePermissions.DisplayName(u.Role) : "";

    // First letter of the user name, shown in the round avatar.
    private static string Initial(System.Security.Claims.ClaimsPrincipal p) =>
        p.Identity?.Name is { Length: > 0 } n ? n[..1].ToUpperInvariant() : "?";
}
