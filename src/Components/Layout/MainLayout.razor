@* The frame around every page: navy top bar with the user menu, navy side menu, and the page in @Body. *@
@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/">Shree Karunambika Traders</a>
        <AuthorizeView>
            <Authorized>
                @* <details> opens and closes without any JavaScript. *@
                <details class="user-menu">
                    <summary>
                        <span class="avatar"><Icon Name="user" Size="22" /></span>
                        <span>@context.User.Identity?.Name</span>
                        <Icon Name="chevron-down" Size="16" />
                    </summary>
                    <div class="user-menu-panel">
                        <div class="user-menu-role">@RoleName(context.User)</div>
                        <a href="/account/change-password"><Icon Name="key" Size="16" /> Change password</a>
                        <form action="/account/logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="/" />
                            <button type="submit"><Icon Name="exit" Size="16" /> Sign out</button>
                        </form>
                    </div>
                </details>
            </Authorized>
        </AuthorizeView>
    </header>

    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss" href="">Dismiss</a>
</div>

@code {
    private static string RoleName(System.Security.Claims.ClaimsPrincipal p) =>
        UserInfo.FromPrincipal(p) is { } u ? RolePermissions.DisplayName(u.Role) : "";
}
