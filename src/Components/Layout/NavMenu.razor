@* Side menu. Shows only the items the logged-in user's role may use. *@

<nav class="nav" aria-label="Main menu">
    @foreach (var group in MenuItems.For(_user).GroupBy(item => item.Group))
    {
        <div class="nav-group">
            <div class="nav-heading">@group.Key</div>
            @foreach (var item in group)
            {
                @if (item.IsReady)
                {
                    @* NavLink adds the "active" class when the URL matches, so the current page is highlighted. *@
                    <NavLink class="nav-link" href="@item.Href" Match="NavLinkMatch.All">@item.Title</NavLink>
                }
                else
                {
                    <span class="nav-link disabled" title="Coming in a later module">@item.Title</span>
                }
            }
        </div>
    }
</nav>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private UserInfo? _user;

    protected override async Task OnParametersSetAsync()
    {
        _user = AuthState is null ? null : UserInfo.FromPrincipal((await AuthState).User);
    }
}
