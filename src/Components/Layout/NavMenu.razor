@* Side menu. It loops over MenuItems.All, grouped by heading. *@
<nav class="nav" aria-label="Main menu">
    @foreach (var group in MenuItems.All.GroupBy(item => item.Group))
    {
        <div class="nav-group">
            <div class="nav-heading">@group.Key</div>
            @foreach (var item in group)
            {
                @if (item.IsReady)
                {
                    @* NavLink adds the "active" class when the URL matches, so the current page is highlighted. *@
                    <NavLink class="nav-link" href="@item.Href" Match="NavLinkMatch.All">@item.Title</NavLink>
                }
                else
                {
                    <span class="nav-link disabled" title="Coming in a later session">@item.Title</span>
                }
            }
        </div>
    }
</nav>
