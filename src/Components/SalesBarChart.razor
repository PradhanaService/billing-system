@* Monthly sales, last 6 months (FR-DASH-04). One series, so no legend: the title names it.
   Plain HTML + CSS bars, no JavaScript. Each bar is a link to Invoice Display for that month,
   with a hover/focus tooltip. Values are printed only on the selected and the largest month;
   the full figures are in the table below the chart. *@
<figure class="barchart" aria-labelledby="chart-title">
    <figcaption id="chart-title" class="chart-title">Monthly sales, last 6 months (₹)</figcaption>
    <div class="plot">
        @foreach (var m in Months)
        {
            var pct = Max == 0 ? 0 : (double)m.SalesPaise / Max * 100;
            var showValue = m.SalesPaise > 0 && (m.Key == SelectedKey || m.SalesPaise == Max);
            <a class="bar-slot @(m.Key == SelectedKey ? "selected" : "")" href="/invoices?month=@m.Key"
               aria-label="@m.Label: ₹@Money.Format(m.SalesPaise). Open invoices for this month.">
                <span class="bar-value">@(showValue ? Short(m.SalesPaise) : "")</span>
                <span class="bar" style="height: @pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                <span class="tip" role="tooltip">@m.Label<br /><strong>₹@Money.Format(m.SalesPaise)</strong></span>
            </a>
        }
    </div>
    <div class="axis">
        @foreach (var m in Months) { <span>@m.Label</span> }
    </div>
    <details class="chart-table">
        <summary>Show as table</summary>
        <table class="data">
            <thead><tr><th>Month</th><th class="num">Sales (₹)</th></tr></thead>
            <tbody>@foreach (var m in Months) { <tr><td>@m.Label</td><td class="num">@Money.Format(m.SalesPaise)</td></tr> }</tbody>
        </table>
    </details>
</figure>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<WaterBilling.Services.Accounts.MonthSales> Months { get; set; } = [];
    [Parameter] public string? SelectedKey { get; set; }

    private long Max => Months.Count == 0 ? 0 : Months.Max(m => m.SalesPaise);

    // 4,94,784.00 -> "4.95 L"; 1,23,45,678 -> "1.23 Cr" (short label on the bar only).
    private static string Short(long paise)
    {
        var rupees = paise / 100m;
        return rupees >= 1_00_00_000 ? $"{rupees / 1_00_00_000:0.##} Cr"
             : rupees >= 1_00_000 ? $"{rupees / 1_00_000:0.##} L"
             : rupees >= 1_000 ? $"{rupees / 1_000:0.#} K"
             : rupees.ToString("0");
    }
}
