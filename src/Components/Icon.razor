@* Simple line icons (24 x 24 grid, drawn in the current text colour), used in the menu, page headers,
   figure cards and quick access tiles. Drawn here as SVG, so nothing is downloaded.
   Decorative by default (hidden from screen readers); give Label when the icon is the only content. *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"
     aria-hidden="@(Label is null ? "true" : null)" role="@(Label is null ? null : "img")" aria-label="@Label">@((MarkupString)(Shapes.GetValueOrDefault(Name) ?? ""))</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Label { get; set; }

