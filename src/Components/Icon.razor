@* Icons from Phosphor Icons (https://phosphoricons.com, MIT licence), stored in PhosphorIcons.cs as plain
   SVG, so nothing is downloaded and the desktop app works offline. Drawn in the current text colour.
   Two styles: Regular (outline, for buttons and small marks) and Duotone (outline with a soft fill,
   for the menu, page headers, figure cards and section titles: set Duotone="true").
   Decorative by default (hidden from screen readers); give Label when the icon is the only content. *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 256 256" fill="currentColor" focusable="false"
     aria-hidden="@(Label is null ? "true" : null)" role="@(Label is null ? null : "img")" aria-label="@Label">@((MarkupString)Shape)</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public bool Duotone { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Label { get; set; }

    private string Shape => (Duotone ? PhosphorIcons.Duotone : PhosphorIcons.Regular).GetValueOrDefault(Name) ?? "";

    // The icon names the app may use (tests check every name in the code exists).
    public static IEnumerable<string> Names => PhosphorIcons.Regular.Keys;
}
