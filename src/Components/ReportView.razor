@* Shows any ReportTable on screen: the same columns as the PDF. *@
<div class="report">
    <h2>@Table.Title</h2>
    @foreach (var line in Table.SubtitleLines) { <div class="muted">@line</div> }
    <table class="data" style="margin-top: 0.75rem">
        <thead>
            <tr>@foreach (var c in Table.Columns) { <th class="@(c.Numeric ? "num" : "")">@c.Title</th> }</tr>
        </thead>
        <tbody>
            @foreach (var row in Table.Rows)
            {
                <tr>@for (var i = 0; i < Table.Columns.Count; i++) { <td class="@(Table.Columns[i].Numeric ? "num" : "")">@Cell(row, i)</td> }</tr>
            }
            @if (Table.Rows.Count == 0) { <tr><td colspan="@Table.Columns.Count" class="muted">No entries for this selection.</td></tr> }
        </tbody>
        <tfoot>
            @foreach (var row in Table.FooterRows)
            {
                <tr>@for (var i = 0; i < Table.Columns.Count; i++) { <td class="@(Table.Columns[i].Numeric ? "num" : "")">@Cell(row, i)</td> }</tr>
            }
        </tfoot>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public ReportTable Table { get; set; } = default!;

    private static string Cell(IReadOnlyList<string> row, int i) => i < row.Count ? row[i] : "";
}
