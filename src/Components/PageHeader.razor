@* The page title block from the designs: a blue icon tile, the title, a one-line description,
   and optional buttons on the right. *@
<div class="page-head">
    <div class="page-head-icon"><Icon Name="@IconName" Size="30" /></div>
    <div class="page-head-text">
        <h1>@Title</h1>
        @if (Subtitle is not null) { <p>@Subtitle</p> }
    </div>
    @if (Actions is not null) { <div class="page-head-actions">@Actions</div> }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string IconName { get; set; } = "invoice";
    [Parameter] public RenderFragment? Actions { get; set; }
}
